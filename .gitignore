```gitignore
# Compiled Python files
*.pyc
__pycache__/

# Virtual environments
venv/
.venv/
.env
.env.local
*.env.*

# Logs
*.log

# Temporary files
*.tmp
*.swp

# IDE/Editor
.vscode/
.idea/

# Build artifacts
dist/
build/
target/

# Dependencies cache
node_modules/
.mypy_cache/
.pytest_cache/
.coverage
coverage/
htmlcov/
```